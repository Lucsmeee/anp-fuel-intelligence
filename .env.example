# Caminho local da pasta com os dados brutos baixados manualmente da ANP
# (usado pelo modo --from-local do extract.py)
DATA_LOCAL_PATH=D:/Projeto ANP

# Modo de operação do extract: from_local (lê do disco) ou download (baixa da ANP)
EXTRACT_MODE=from_local

# Conexão PostgreSQL (preencha quando o banco estiver configurado)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=anp_fuel
DB_USER=postgres
DB_PASSWORD=009988